{
  "expo": {
    "name": "Vaniki Dealers",
    "slug": "vaniki-dealers-play",
    "version": "1.0.0",
    "description": "Vaniki Dealers — India's B2B agri-input procurement platform. Buy genuine pesticides, insecticides, fungicides & herbicides in bulk with minimum order quantities. Manage orders, invoices, referrals and settlements in one app.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "vanikidealers",
    "primaryColor": "#2D6A4F",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2D6A4F",
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "ndkVersion": "28.2.13676358",
            "useLegacyPackaging": false,
            "extraGradleProperties": [
              {"name": "org.gradle.jvmargs", "value": "-Xmx1200m -XX:MaxMetaspaceSize=256m -XX:+UseParallelGC"},
              {"name": "org.gradle.parallel", "value": "false"},
              {"name": "org.gradle.workers.max", "value": "1"},
              {"name": "reactNativeArchitectures", "value": "arm64-v8a"},
              {"name": "org.gradle.java.home", "value": "/usr/lib/jvm/java-17-openjdk-amd64"}
            ]
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vanikicrop.dealers"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.vanikicrop.dealers",
      "versionCode": 1,
      "targetSdkVersion": 36,
      "softwareKeyboardLayoutMode": "resize",
      "androidStatusBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#F8FAF9",
        "translucent": false
      },
      "androidNavigationBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2db8ff2d-1cfa-452f-9bf6-157bc791d7d1"
      }
    }
  }
}
